generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums
enum Gender {
  male
  female
  other
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

// ==========================================
// 1. User & Profile Models
// ==========================================

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  passwordHash   String?   @map("password_hash")
  authProviderId String    @default("local") @map("auth_provider_id")
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  profile               UserProfile?
  measurementHistory    UserMeasurementHistory[]
  foodLogs              FoodLog[]
  hydrationLogs         HydrationLog[]
  reminders             SmartReminder[]
  badges                UserBadge[]
  weeklyChallenges      UserWeeklyChallenge[]
  bctCompletions        UserBctCompletion[]

  following             UserFollow[]             @relation("UserFollowing")
  followers             UserFollow[]             @relation("UserFollowers")
  streakInitiator       StreakPartner[]          @relation("UserStreakInitiator")
  streakRecipient       StreakPartner[]          @relation("UserStreakRecipient")
  articleLikes          ArticleLike[]
  articleBookmarks      ArticleBookmark[]
  receivedNotifications UserNotification[]       @relation("UserNotifications")
  sentNotifications     UserNotification[]       @relation("SenderNotifications")

  @@map("users")
}

model UserProfile {
  userId                String    @id @map("user_id") @db.Uuid
  name                  String
  birthDate             DateTime  @map("birth_date") @db.Date
  gender                Gender
  heightCm              Float     @map("height_cm")
  weightKg              Float     @map("weight_kg")
  xp                    Int       @default(0)
  inviteCode            String?   @unique @map("invite_code")
  school                String?   @map("school")
  bio                   String?   @map("bio")
  avatarLetter          String?   @map("avatar_letter")
  currentStreakDays     Int       @default(0) @map("current_streak_days")
  longestStreakDays     Int       @default(0) @map("longest_streak_days")
  lastHydrationResetAt  DateTime? @map("last_hydration_reset_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserMeasurementHistory {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  measuredAt  DateTime @default(now()) @map("measured_at")
  heightCm    Float    @map("height_cm")
  weightKg    Float    @map("weight_kg")
  bmi         Float
  bmiCategory String   @map("bmi_category")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measuredAt])
  @@map("user_measurement_history")
}

// ==========================================
// 2. Food, Catalog & Logging Models
// ==========================================

model FoodGroup {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  foodCatalogs FoodCatalog[]

  @@map("food_groups")
}

model FoodCatalog {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
  foodGroupId     String   @map("food_group_id") @db.Uuid
  defaultImageUrl String?  @map("default_image_url")
  source          String   @default("system")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  foodGroup FoodGroup @relation(fields: [foodGroupId], references: [id], onDelete: Cascade)
  foodLogs  FoodLog[]

  @@index([foodGroupId])
  @@map("food_catalog")
}

model FoodLog {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  foodCatalogId String?   @map("food_catalog_id") @db.Uuid
  foodName      String    @map("food_name")
  mealType      MealType  @map("meal_type")
  loggedAt      DateTime  @default(now()) @map("logged_at")
  imageUrl      String?   @map("image_url")
  isAiDetected  Boolean   @default(false) @map("is_ai_detected")
  aiConfidence  Float?    @map("ai_confidence")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodCatalog FoodCatalog? @relation(fields: [foodCatalogId], references: [id], onDelete: SetNull)

  @@index([userId, loggedAt])
  @@map("food_logs")
}

// ==========================================
// 3. Hydration Model
// ==========================================

model HydrationLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amountMl  Int      @map("amount_ml")
  loggedAt  DateTime @default(now()) @map("logged_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@map("hydration_logs")
}

// ==========================================
// 4. Smart Reminders Models (Template + User)
// ==========================================

model ReminderTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  category     String?  @map("category")
  subType      String?  @map("sub_type")
  optionNumber Int      @default(1) @map("option_number")
  title        String
  description  String   @db.Text
  reminderTime String   @map("reminder_time")
  iconKey      String?  @map("icon_key")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  userReminders SmartReminder[]

  @@map("reminder_templates")
}

model SmartReminder {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  templateId   String?  @map("template_id") @db.Uuid
  category     String?  @map("category")
  subType      String?  @map("sub_type")
  optionNumber Int?     @default(1) @map("option_number")
  title        String
  description  String   @db.Text
  reminderTime String   @map("reminder_time")
  isEnabled    Boolean  @default(true) @map("is_enabled")
  iconKey      String?  @map("icon_key")
  repeatRule   String?  @map("repeat_rule")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template ReminderTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([userId, isEnabled])
  @@index([userId, templateId])
  @@map("smart_reminders")
}

// ==========================================
// 5. Badges & Gamification Models
// ==========================================

model Badge {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  title       String
  description String   @db.Text
  iconKey     String?  @map("icon_key")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  badgeId    String    @map("badge_id") @db.Uuid
  unlockedAt DateTime? @map("unlocked_at")
  isUnlocked Boolean   @default(false) @map("is_unlocked")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model WeeklyChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String    @db.Text
  category    String?
  rewardXp    Int       @map("reward_xp")
  targetDays  Int       @default(7) @map("target_days")
  isActive    Boolean   @default(true) @map("is_active")
  startsOn    DateTime? @map("starts_on") @db.Date
  endsOn      DateTime? @map("ends_on") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  userChallenges UserWeeklyChallenge[]

  @@map("weekly_challenges")
}

model UserWeeklyChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  challengeId    String    @map("challenge_id") @db.Uuid
  weekStart      DateTime  @db.Date @map("week_start")
  currentDays    Int       @default(0) @map("current_days")
  isCompleted    Boolean   @default(false) @map("is_completed")
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  lastProgressAt DateTime? @map("last_progress_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge WeeklyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId, weekStart])
  @@index([userId, weekStart])
  @@map("user_weekly_challenges")
}

// ==========================================
// 6. Food Group Recommendations (Client Master & BCT Dataset)
// ==========================================

model FoodGroupRecommendation {
  id              String   @id @default(uuid()) @db.Uuid
  no              Int      @unique
  foodGroupName   String   @unique @map("food_group_name")
  targetDirection String   @map("target_direction")
  targetDaily     Int      @default(1) @map("target_daily")
  targetWeekly    Int      @default(7) @map("target_weekly")
  messageKurang   String   @db.Text @map("message_kurang")
  messageSesuai   String   @db.Text @map("message_sesuai")
  messageLebih    String   @db.Text @map("message_lebih")
  iconKey         String?  @map("icon_key")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  userCompletions UserBctCompletion[]

  @@map("food_group_recommendations")
}

model UserBctCompletion {
  id                        String   @id @default(uuid()) @db.Uuid
  userId                    String   @map("user_id") @db.Uuid
  foodGroupRecommendationId String   @map("food_group_recommendation_id") @db.Uuid
  completionDate            DateTime @map("completion_date") @db.Date
  isCompleted               Boolean  @default(false) @map("is_completed")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodGroupRecommendation FoodGroupRecommendation @relation(fields: [foodGroupRecommendationId], references: [id], onDelete: Cascade)

  @@unique([userId, foodGroupRecommendationId, completionDate])
  @@map("user_bct_completions")
}

// ==========================================
// 7. Social Friends & Streak Connection Models
// ==========================================

model UserFollow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("user_follows")
}

model StreakPartner {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  partnerId    String    @map("partner_id") @db.Uuid
  status       String    @default("pending") // "pending", "active", "rejected", "ended"
  streakDays   Int       @default(1) @map("streak_days")
  lastPingAt   DateTime? @map("last_ping_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         User      @relation("UserStreakInitiator", fields: [userId], references: [id], onDelete: Cascade)
  partner      User      @relation("UserStreakRecipient", fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([userId, partnerId])
  @@map("streak_partners")
}

// ==========================================
// 8. Education & Nutrition Articles Models
// ==========================================

model EducationArticle {
  id               String   @id @default(uuid()) @db.Uuid
  title            String
  category         String
  readTimeMinutes  String   @default("3 menit") @map("read_time_minutes")
  summary          String   @db.Text
  contentMarkdown  String   @db.Text @map("content_markdown")
  imageUrl         String?  @map("image_url")
  tag              String?
  sourceUrl        String?  @map("source_url")
  author           String   @default("Tim Ahli Gizi NUTRACK")
  publishedDate    String   @default("Hari ini") @map("published_date")
  keyTakeaways     String[] @default([]) @map("key_takeaways")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  likes            ArticleLike[]
  bookmarks        ArticleBookmark[]

  @@map("education_articles")
}

model ArticleLike {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   EducationArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@map("article_likes")
}

model ArticleBookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   EducationArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@map("article_bookmarks")
}

model NutritionGlossary {
  id         String   @id @default(uuid()) @db.Uuid
  term       String   @unique
  category   String
  definition String   @db.Text
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("nutrition_glossary")
}

// ==========================================
// 9. In-App User Notifications
// ==========================================

model UserNotification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  senderId  String?  @map("sender_id") @db.Uuid
  type      String   // 'streak_invite', 'streak_ping', 'streak_accept', 'streak_end'
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  sender User? @relation("SenderNotifications", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@map("user_notifications")
}